#!/data/data/com.termux/files/usr/bin/sh
# opencode launcher for Termux (Android, aarch64)
# The musl build of opencode needs /lib/ld-musl-aarch64.so.1 which does not
# exist on Termux (bionic libc). We ship the musl loader + libs in this dir
# and invoke the loader directly with --library-path. No patchelf needed.
#
# termux-exec's bionic LD_PRELOAD breaks the musl loader (symbol not found
# on __errno, __register_atfork, ...) — drop it before exec.
unset LD_PRELOAD
unset LD_LIBRARY_PATH
exec /data/data/com.termux/files/usr/lib/opencode/ld-musl-aarch64.so.1 \
  --library-path /data/data/com.termux/files/usr/lib/opencode \
  /data/data/com.termux/files/usr/lib/opencode/opencode "$@"
